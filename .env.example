# Google Apps Script web app URL (Deploy > Web app > Anyone).
# Keep this on the server only — do not prefix with NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional shared secret. If set, the Apps Script should reject payloads that do not match.
GOOGLE_SHEETS_SECRET=change-me
